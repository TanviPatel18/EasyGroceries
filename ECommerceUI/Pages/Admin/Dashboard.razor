@page "/admin/dashboard"
@* @page "/admin/dashboard" *@
@layout AdminLayout
@using ECommerceUI.Models.Admin
@using ECommerceUI.Services.other

@inject DashboardService DashboardSvc

<div class="dashboard-container">

    <div class="dashboard-header">
        <h1>Dashboard</h1>
        @* <p>Welcome Back 👋</p> *@
    </div>

    <!-- CARDS -->
    <div class="stats-grid">

        <div class="stat-card">
            <h2>@dashboard.TotalOrders</h2>
            <p>Total Orders</p>
        </div>

        <div class="stat-card">
            <h2>@dashboard.PendingOrders</h2>
            <p>Pending</p>
        </div>

        <div class="stat-card">
            <h2>@dashboard.ProcessingOrders</h2>
            <p>Processing</p>
        </div>

        <div class="stat-card">
            <h2>@dashboard.ShippedOrders</h2>
            <p>Shipped</p>
        </div>

        <div class="stat-card">
            <h2>@dashboard.DeliveredOrders</h2>
            <p>Delivered</p>
        </div>

        <div class="stat-card revenue">
            <h2>₹ @dashboard.TotalRevenue</h2>
            <p>Total Revenue</p>
        </div>

    </div>

    <!-- TABLE -->
    <div class="table-container">

        <h3>Recent Orders</h3>

        <table class="dashboard-table">

            <thead>
                <tr>
                    <th>OrderId</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Shipping</th>
                    <th>Total</th>
                    <th>Date</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var order in dashboard.RecentOrders)
                {
                    <tr>

                        <td>#@order.Id</td>

                        <td>@order.OrderStatus</td>

                        <td>@order.PaymentStatus</td>

                        <td>@order.ShippingStatus</td>

                        <td>₹ @order.OrderTotal</td>

                        <td>
                            @order.OrderDate
                            .ToString("dd MMM yyyy")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@code {

    private DashboardDto dashboard = new();

    protected override async Task OnInitializedAsync()
    {
        dashboard =
            await DashboardSvc.GetDashboardAsync();
    }
}